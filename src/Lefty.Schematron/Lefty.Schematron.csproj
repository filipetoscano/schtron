<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      A public member added without documentation fails the build. Note this
      catches missing comments, not empty ones: '/// <summary />' satisfies
      the compiler while telling a consumer nothing.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <PackageDescription>Swiss-knife for Schematron operations, using .NET.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\**\*.xsl" />
    <None Remove="Resources\**\*.xsd" />
    <EmbeddedResource Include="Resources\**\*.xsl" />
    <EmbeddedResource Include="Resources\**\*.xsd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="SaxonHE12s9apiExtensions" Version="12.10.1" />
  </ItemGroup>

</Project>
